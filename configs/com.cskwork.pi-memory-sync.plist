<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.cskwork.pi-memory-sync</string>
  <key>ProgramArguments</key> <array>
    <string>/bin/bash</string>
    <string>/Users/danny/pi-setup/sync-memory.sh</string>
  </array>
  <key>StartCalendarInterval</key> <dict>
    <key>Hour</key>   <integer>21</integer>
    <key>Minute</key> <integer>0</integer>
  </dict>
  <key>RunAtLoad</key> <false/>
  <key>EnvironmentVariables</key> <dict>
    <key>HOME</key> <string>/Users/danny</string>
    <key>PATH</key> <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>   <string>/Users/danny/Library/Logs/pi-memory-sync.out.log</string>
  <key>StandardErrorPath</key> <string>/Users/danny/Library/Logs/pi-memory-sync.err.log</string>
</dict>
</plist>
