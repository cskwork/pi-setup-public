{
  "_comment": "Friendly starter policy for pi-permission-system. Feels like stock pi (no nagging) with rails only where it matters: secrets stay unreadable, destructive shell asks, everything else flows. Edit ~/.pi/agent/extensions/pi-permission-system/config.json (or the TUI /permissions modal) to personalize.",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny"
    },
    "read": "allow",
    "find": "allow",
    "grep": "allow",
    "ls": "allow",
    "glob": "allow",
    "skill": "allow",
    "ctx_execute": "allow",
    "ctx_execute_file": "allow",
    "ctx_search": "allow",
    "ctx_index": "allow",
    "ctx_fetch_and_index": "allow",
    "ctx_batch_execute": "allow",
    "ctx_stats": "allow",
    "ctx_doctor": "allow",
    "ctx_upgrade": "allow",
    "ctx_insight": "allow",
    "ctx_purge": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "diff": "allow",
      "diff *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "uniq": "allow",
      "uniq *": "allow",
      "comm": "allow",
      "comm *": "allow",
      "cut": "allow",
      "cut *": "allow",
      "md5": "allow",
      "md5 *": "allow",
      "shasum": "allow",
      "shasum *": "allow",
      "readlink": "allow",
      "readlink *": "allow",
      "realpath": "allow",
      "realpath *": "allow",
      "basename": "allow",
      "basename *": "allow",
      "dirname": "allow",
      "dirname *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "column": "allow",
      "column *": "allow",
      "printenv": "allow",
      "printenv *": "allow",
      "uname": "allow",
      "uname *": "allow",
      "id": "allow",
      "whoami": "allow",
      "sleep": "allow",
      "sleep *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "git blame *": "allow",
      "git config --get *": "allow",
      "git config --list": "allow",
      "git tag": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.agents": "allow",
      "~/.agents/*": "allow",
      "~/pi-setup": "allow",
      "~/pi-setup/*": "allow",
      "~/.pi": "allow",
      "~/.pi/*": "allow",
      "~/.claude/skills/*": "allow",
      "~/.codex/skills/*": "allow",
      "~/.gemini/skills/*": "allow",
      "~/.grok/skills/*": "allow",
      "/tmp/*": "allow"
    }
  }
}
