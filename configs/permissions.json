{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*application*.yml": "deny",
      "*application*.yaml": "deny",
      "*application*.properties": "deny",
      "*credentials*": "deny",
      "*secrets.*": "deny",
      "*.pem": "deny",
      "*.p12": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "*.env.dist": "allow",
      "*example*.env": "allow",
      "*template*.env": "allow",
      "*sample*.env": "allow",
      "*application*example*": "allow",
      "*application*sample*": "allow",
      "*application*template*": "allow",
      "*.example": "allow",
      "*.sample": "allow",
      "*.template": "allow",
      "*.dist": "allow",
      "~/.ssh/*": "deny"
    },
    "ctx_purge": "ask",
    "mcp": {
      "*": "allow",
      "ctx_purge": "ask"
    },
    "bash": {
      "*": "allow",

      "rm -r*": "ask",
      "rm -fr*": "ask",
      "rm --recursive *": "ask",
      "shred *": "ask",
      "truncate *": "ask",
      "dd *": "ask",
      "sudo *": "ask",

      "git reset --hard *": "ask",
      "git reset --merge *": "ask",
      "git clean *-f*": "ask",
      "git restore *": "ask",
      "git checkout -- *": "ask",
      "git checkout -f *": "ask",
      "git switch -f *": "ask",
      "git branch -D *": "ask",
      "git tag -d *": "ask",
      "git stash drop *": "ask",
      "git stash clear": "ask",
      "git reflog delete *": "ask",
      "git reflog expire *": "ask",
      "git worktree remove *": "ask",
      "git filter-branch *": "ask",
      "git filter-repo *": "ask",
      "git update-ref -d *": "ask",
      "git push *--force*": "ask",
      "git push *--delete*": "ask",

      "rm -rf /": {
        "action": "deny",
        "reason": "Refusing to recursively delete the filesystem root"
      },
      "rm -fr /": {
        "action": "deny",
        "reason": "Refusing to recursively delete the filesystem root"
      },
      "rm -rf --no-preserve-root /": {
        "action": "deny",
        "reason": "Refusing to recursively delete the filesystem root"
      },
      "rm -R /": {
        "action": "deny",
        "reason": "Refusing to recursively delete the filesystem root"
      },
      "rm --recursive /": {
        "action": "deny",
        "reason": "Refusing to recursively delete the filesystem root"
      },
      "mkfs*": {
        "action": "deny",
        "reason": "Filesystem formatting is blocked"
      },
      "diskutil erase*": {
        "action": "deny",
        "reason": "Disk erasure is blocked"
      },
      "diskutil secureErase*": {
        "action": "deny",
        "reason": "Disk erasure is blocked"
      },
      "diskutil partitionDisk*": {
        "action": "deny",
        "reason": "Disk repartitioning is blocked"
      }
    },
    "external_directory": "allow"
  }
}
